{
  "name": "southbound35-subscribe-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that captures Southbound 35 newsletter signups into D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute southbound35-subscribers --file=./schema.sql --remote",
    "schema:local": "wrangler d1 execute southbound35-subscribers --file=./schema.sql --local"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
