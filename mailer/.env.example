# Copy this file to .env and fill in real values. .env is gitignored.

# SMTP credentials — Gmail with an App Password is the easy path.
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password

# Display name on outbound emails
FROM_NAME=Scott Langford

# Reply-To header (defaults to SMTP_USER if unset)
REPLY_TO=scottlangford@txstate.edu

# Where the Jekyll blog repo lives locally (used to find _posts/*.md)
POSTS_DIR=/Users/scottlangford/scott_langford/_posts

# Blog base URL (used to build the live post link)
SITE_BASE_URL=https://scottlangford2.github.io/scott_langford

# Seconds to wait between sends (avoids triggering SMTP rate limits)
THROTTLE_SECONDS=2.0
