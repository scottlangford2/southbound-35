<dict>
    <key>Label</key>
    <string>com.langfordlab.southbound35.subscriber-notify</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
