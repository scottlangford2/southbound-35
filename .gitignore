__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Data (downloaded at runtime)
posts/*/data/*.csv
!posts/*/data/.gitkeep

# Figures (regenerate from code)
posts/*/figures/*.png
posts/*/graphics/*.png
!posts/*/figures/.gitkeep
!posts/*/graphics/.gitkeep

# Shapefiles (refetched on demand)
posts/*/inputs/shapefiles/

.DS_Store

# Mailer secrets and subscriber list (NEVER commit)
mailer/.env
mailer/subscribers.csv

# Cloudflare Worker deps and cache (NEVER commit)
subscribe-worker/node_modules/
subscribe-worker/.wrangler/

# Extra guards for off-repo newsletter data (lives in ~/lookout_local/southbound35)
.env
*subscribers*.csv
sent.json
